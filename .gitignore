# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Secrets — never commit these regardless of tool
*.pem
*.key
.env
*_rsa
*_ed25519
vault_pass.txt

# Terraform / OpenTofu
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# Ansible
*.retry

# General
*.log

# Generated Ansible inventory — produced by scripts/geninventory.sh from
# whatever VMs are running. Addresses are DHCP-assigned and change constantly,
# so committing this file would mean tracking meaningless churn. Regenerate it
# rather than storing it.
projects/*/ansible/inventory.yml
